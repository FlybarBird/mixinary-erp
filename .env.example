NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-your-openai-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BRAND_NAME=Mixinary ERP

# Suite / Project Management (Plane fork)
# NEXT_PUBLIC_PM_BASE_PATH=/project-management
# NEXT_PUBLIC_SHARED_FILES_URL=/shared-files
# MIXINARY_COMPANY_ID=mixinary
# INTEGRATION_BASE_URL=http://127.0.0.1:8091
# INTEGRATION_WEBHOOK_SECRET=change-me-webhook-hmac

# Authentik OIDC (suite SSO)
# AUTHENTIK_ISSUER=https://example.com/application/o/mixinary-erp/
# AUTHENTIK_CLIENT_ID=mixinary-erp
# AUTHENTIK_CLIENT_SECRET=
# AUTHENTIK_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
# AUTHENTIK_AUTHORIZE_URL=
# AUTHENTIK_TOKEN_URL=
# AUTHENTIK_USERINFO_URL=
# AUTHENTIK_END_SESSION_URL=

# Local SQLite mode (optional)
# NEXT_PUBLIC_MIXINARY_LOCAL_MODE=true
# MIXINARY_LOCAL_MODE=true
# Optional: pre-create admin via env instead of /setup
# LOCAL_ADMIN_EMAIL=you@example.com
# LOCAL_ADMIN_PASSWORD=

# Transactional email (Shadow PMS–style: Resend preferred)
# RESEND_API_KEY=re_xxxxx
# RESEND_FROM="Mixinary ERP <noreply@yourdomain.com>"

# Optional SMTP fallback when Resend is not set
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Mixinary ERP <noreply@example.com>"
# SMTP_SECURE=false

# Optional part enrichment
ICECAT_USERNAME=
ICECAT_PASSWORD=
UPCITEMDB_USER_KEY=
