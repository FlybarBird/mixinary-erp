HULY_VERSION=v0.7.426
DESKTOP_CHANNEL=0.7.426
DOCKER_NAME=mixinary-pm

# Public host as seen by browsers (Cloudflare hostname; path /project-management)
HOST_ADDRESS=example.com
SECURE=true
HTTP_PORT=8087
HTTP_BIND=127.0.0.1
TITLE=Mixinary Project Management
DEFAULT_LANGUAGE=en
LAST_NAME_FIRST=true

SECRET=change-me-huly-server-secret
COCKROACH_SECRET=change-me-cockroach
CR_DATABASE=mixinary_pm
CR_USERNAME=mixinary_pm
CR_USER_PASSWORD=change-me-cockroach
CR_DB_URL=postgres://mixinary_pm:change-me-cockroach@mixinary-pm-cockroach:26257/mixinary_pm

REDPANDA_ADMIN_USER=mixinary_pm
REDPANDA_SECRET=change-me-redpanda

# Authentik OIDC (account service)
OPENID_CLIENT_ID=mixinary-pm
OPENID_CLIENT_SECRET=
OPENID_ISSUER=https://example.com/application/o/mixinary-pm/

APP_BASE_PATH=/project-management
