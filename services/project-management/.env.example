# OpenProject packaging for Mixinary suite PM
OPENPROJECT_VERSION=17

# Bind only on loopback; Cloudflare Tunnel fronts HTTPS.
HTTP_BIND=127.0.0.1
LISTEN_HTTP_PORT=8087

# Public hostname browsers use (no scheme).
# Local: localhost:8087
# Prod behind Cloudflare on same host as ERP: example.com
OPENPROJECT_HOST__NAME=localhost:8087
OPENPROJECT_HTTPS=false
OPENPROJECT_DEFAULT__LANGUAGE=en

# Must be unique & secret (openssl rand -hex 64). Changing invalidates sessions.
SECRET_KEY_BASE=change-me-openssl-rand-hex-64

# Postgres (compose-internal)
OPENPROJECT_DB_USER=openproject
OPENPROJECT_DB_PASSWORD=change-me-openproject-db
OPENPROJECT_DB_NAME=openproject

# Suite path — keep in sync with NEXT_PUBLIC_PM_BASE_PATH
APP_BASE_PATH=/project-management

# --- Community password login (works without Enterprise) ---
# First-boot seed only. Login remains "admin".
OPENPROJECT_SEED__ADMIN__USER__PASSWORD=admin
# Force password change on first interactive login (recommended).
OPENPROJECT_SEED__ADMIN__USER__PASSWORD__RESET=true
OPENPROJECT_SEED__ADMIN__USER__MAIL=admin@example.net
OPENPROJECT_SEED__ADMIN__USER__NAME=OpenProject Admin
OPENPROJECT_SEED__ADMIN__USER__LOCKED=false
OPENPROJECT_DISABLE__PASSWORD__LOGIN=false
OPENPROJECT_LOGIN__REQUIRED=true

# Authentik OIDC — Enterprise add-on only. Leave blank on Community.
# See company/oidc/authentik.env.example and docs/LOGIN.md
OIDC_DISPLAY_NAME=Authentik
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
